# Use a descriptive contact address in the User-Agent for Wikimedia API requests.
PHONE_DATA_USER_AGENT=PhoneLaunchPricesStudentProject/0.1 (contact: your-email@example.com)
# Seconds between requests. GSMArena serves about 7.5 pages a minute to one
# address; a shorter delay only triggers its "please slow down" page.
PHONE_DATA_DELAY_SECONDS=8
PHONE_DATA_TIMEOUT_SECONDS=20
PHONE_DATA_RETRIES=4
